---
import Base from '../../layouts/Base.astro';
import AlbumHead from '../../components/AlbumHead.astro';
import PhotoGallery from '../../components/PhotoGallery.jsx';
import '../../styles/gallery.css';
import { getPhotographs } from '@/lib/photography.js';
const photos = await getPhotographs();
---
<Base title="Photography" description="Selected photographs by Yuhua (Benji) Huang.">
  <div class="photography-page">
    <AlbumHead current="photography">Places, people, and the moments in between.</AlbumHead>
    <section class="photo-collection wrap" aria-label="Selected photographs">
      <PhotoGallery client:load photos={photos} adaptToTime />
    </section>
  </div>
</Base>
