---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getTags } from '../../lib/posts';
const posts = await getPosts();
const essays = posts.filter((p) => p.data.section === 'writing');
const notes = posts.filter((p) => p.data.section === 'blog');
const tags = await getTags();
---
<Base title="Writing" description="Essays, technical deep dives, and quick notes.">
  <section class="page-head wrap">
    <h1 class="display">Writing</h1>
    <p class="lede">Essays and technical deep dives, worked through. Below them, quick notes: things I found and whatever I feel like keeping.</p>
  </section>

  <section class="band wrap row" aria-labelledby="essays-title">
    <h2 class="section-title" id="essays-title">Essays</h2>
    <div>
      {essays.length > 0 ? <PostList posts={essays} variant="essay" showMeta /> : <p class="empty">No essays yet. The notes below are where things start.</p>}
    </div>
  </section>

  <section class="band wrap row" aria-labelledby="notes-title">
    <h2 class="section-title" id="notes-title">Notes</h2>
    <div>
      {notes.length > 0 ? <PostList posts={notes} variant="note" /> : <p class="empty">No notes yet.</p>}
    </div>
  </section>

  {tags.length > 0 && (
    <section class="band wrap row" aria-labelledby="tags-title">
      <h2 class="section-title" id="tags-title">Tags</h2>
      <ul class="tag-cloud">
        {tags.map((t) => <li><a href={`/blog/tag/${t}/`}>#{t}</a></li>)}
      </ul>
    </section>
  )}
</Base>
