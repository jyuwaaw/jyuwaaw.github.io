---
// Chinese variants: the part of a post after its `<!-- zh -->` marker.
import PostPage from '../../../components/PostPage.astro';
import { getPosts } from '../../../lib/posts';
export async function getStaticPaths() {
  return (await getPosts('zh')).map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
---
<PostPage post={Astro.props.post} />
