---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORY_LABELS, fmtDate, getSeries, postUrl, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const { data } = post;
const zh = data.lang === 'zh';
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const series = data.series ? await getSeries(data.series, data.lang) : [];
// The other language variant of the same file, when there is one.
const other = data.bilingual ? await getEntry('posts', zh ? data.slug : `${data.slug}.zh`) : undefined;
const alternates = other
  ? [{ lang: zh ? 'zh-Hans' : 'en', href: postUrl(post) }, { lang: zh ? 'en' : 'zh-Hans', href: postUrl(other) }]
  : [];
const date = fmtDate(data.date);
---
<Base title={data.title} description={data.excerpt || undefined} lang={zh ? 'zh-Hans' : 'en'} type="article" alternates={alternates}>
  <article class="post wrap row" lang={zh ? 'zh-Hans' : 'en'}>
    <aside class="post-aside" lang="en">
      <a class="back" href="/blog/">← Writing</a>
      <dl>
        <div><dt>Published</dt><dd><time datetime={date}>{date}</time></dd></div>
        <div><dt>Filed under</dt><dd>{CATEGORY_LABELS[data.category]}</dd></div>
        {other && (
          <div>
            <dt>Language</dt>
            <dd class="lang-switch">
              <a href={zh ? postUrl(other) : postUrl(post)} aria-current={zh ? undefined : 'true'} hreflang="en">EN</a>
              <a href={zh ? postUrl(post) : postUrl(other)} aria-current={zh ? 'true' : undefined} hreflang="zh-Hans" lang="zh-Hans">中文</a>
            </dd>
          </div>
        )}
      </dl>
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <span>On this page</span>
          <ol lang={zh ? 'zh-Hans' : 'en'}>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </aside>
    <div>
      <h1>{data.title}</h1>
      <div class="prose"><Content /></div>
      <footer class="post-foot" lang="en">
        {data.tags.length > 0 && (
          <ul class="tag-cloud">{data.tags.map((t) => <li><a href={`/blog/tag/${t}/`}>#{t}</a></li>)}</ul>
        )}
        {data.source && <p class="post-source">Source: <a href={data.source} target="_blank" rel="noreferrer">{data.source}</a></p>}
        {series.length > 1 && (
          <aside class="series">
            <h2>Series · {data.series}</h2>
            <ol lang={zh ? 'zh-Hans' : 'en'}>
              {series.map((p) => <li>{p.id === post.id ? <span>{p.data.title}</span> : <a href={postUrl(p)}>{p.data.title}</a>}</li>)}
            </ol>
          </aside>
        )}
      </footer>
    </div>
  </article>
</Base>
