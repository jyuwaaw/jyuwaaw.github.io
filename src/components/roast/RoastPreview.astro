---
import { example } from './example.js';
---
<div class="roast-preview" aria-hidden="true">
  <div class="input-strip">
    <span class="caption">Sample home screen</span>
    <div class="apps">
      <span>AI</span><span>AI</span><span>AI</span><span class="mail">@<b>307</b></span>
    </div>
  </div>
  <div class="reading">
    <div class="reading-head"><span class="caption">MBTI guess</span><strong>{example.mbti}</strong></div>
    <div class="quote" lang="zh-CN"><b>{example.title}</b><p>{example.roast}</p></div>
  </div>
</div>
<style>
  .roast-preview{
    background:var(--surface-2); color:var(--text); padding:clamp(19px,3vw,40px);
  }
  .caption{ display:block; color:var(--muted); font:400 12px/1.4 var(--sans); }
  .input-strip{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px 16px; padding-bottom:20px; border-bottom:1px solid var(--border-2); }
  .apps{ display:flex; gap:5px; }
  .apps>span{ display:grid; place-items:center; position:relative; width:29px; height:29px; font:500 13px/1 var(--sans); background:var(--border); border-radius:6px; }
  .apps>span:nth-child(2){ background:var(--text); color:var(--surface); }
  .apps>span:nth-child(3){ border:1px solid var(--muted); background:transparent; }
  .mail b{ position:absolute; top:-7px; right:-7px; font:500 9px/1.2 var(--sans); padding:2px 4px; border-radius:6px; background:var(--accent); color:var(--on-accent); }
  .reading{ padding-top:18px; }
  .reading-head strong{ display:block; margin:2px 0 14px; font:400 clamp(54px,6vw,84px)/.96 var(--display); letter-spacing:-.065em; }
  .quote b{ font-size:14px; font-weight:600; }
  .quote p{ margin-top:5px; font-size:14px; line-height:1.6; color:var(--body-text); }
</style>
