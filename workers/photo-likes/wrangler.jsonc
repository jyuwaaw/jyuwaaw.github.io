{
  "name": "benji-photo-likes",
  "main": "index.mjs",
  "compatibility_date": "2026-10-16",
  "vars": { "ALLOWED_ORIGINS": "https://jyuwaaw.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "benji-photo-likes",
    "database_id": "REPLACE_WITH_PERSONAL_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 120, "period": 60 }
  }]
}
